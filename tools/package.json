{
  "name": "@musher-dev/spec-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Non-normative build and validation scripts for the Musher specification. Not published; not part of the contract.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "bun run src/lint.ts",
    "bundle": "bun run src/bundle.ts",
    "drift": "bun run src/drift.ts",
    "examples": "bun run src/examples.ts",
    "conformance": "bun run src/conformance.ts",
    "catalog": "bun run src/catalog.ts",
    "site": "bun run src/site.ts",
    "format": "biome format --write .",
    "format:check": "biome ci ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commonmark": "0.31.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@sourcemeta/jsonschema": "^16.8.0",
    "@types/bun": "1.3.14",
    "@types/commonmark": "0.27.10",
    "cspell": "10",
    "markdownlint-cli2": "0.23.2",
    "typescript": "7.0.2",
    "wrangler": "4.124.0"
  }
}
