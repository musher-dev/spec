{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "packages": {
    "specifications/component/v1": {
      "component": "component",
      "initial-version": "1.0.0"
    },
    "specifications/blueprint/v1": {
      "component": "blueprint",
      "initial-version": "1.0.0"
    },
    "specifications/listing/v1": {
      "component": "listing",
      "initial-version": "1.0.0"
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Additions" },
    { "type": "fix", "section": "Corrections" },
    { "type": "docs", "section": "Specification prose" },
    { "type": "perf", "section": "Performance", "hidden": true },
    { "type": "chore", "section": "Maintenance", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Conformance", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ]
}
